@model PetHealthcare.MVC.ViewModels.CarouselImages.CarouselImageDeleteViewModel
@{
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<form asp-area="Admin" asp-controller="CarouselImages" asp-action="Delete" asp-route-id="@Model.CarouselImage!.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="container text-light" style="width:100%">
        <div class="col-12">
            <h6 class="text-danger">Are you sure you want to delete this image? </h6>
            <hr />
            <input type="hidden" asp-for="@Model.CarouselImage!.Id" />
            <div class="form-group row">
                <div class="col-3 offset-1">
                    <label>Subject</label>
                </div>
                <div class="col-7">
                    <input asp-for="@Model.CarouselImage!.Subject" class="form-control" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-3 offset-1">
                    <label>Caption</label>
                </div>
                <div class="col-7">
                    <input asp-for="@Model.CarouselImage!.Caption" class="form-control" />
                </div>
            </div>
            <hr />
            <div class="form-group row">
                <div class="col-6 text-center">
                    <button type="submit" class="btn btn-outline-danger form-conrol" style="width:140px;">Delete</button>
                </div>
                <div class="col-6 text-center">
                    <button type="button" id="buttonModalContentCancel" onclick="$('#imageDeleteConfirmModal').modal('hide');" class="btn btn-outline-info form-conrol" style="width:140px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>


