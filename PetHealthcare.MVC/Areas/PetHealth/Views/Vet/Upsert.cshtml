@model PetHealthcare.MVC.ViewModels.Vet.VetUpsertViewModel

@{
    @if (Model.Vet!.Id == 0) ViewData["Title"] = "Add Vet";
    else ViewData["Title"] = $"Update Vet {@Model.Vet.Doctor}";
}
<br/>
<div class="card border-primary text-center text-info" style="height:80%;">
    <div class="card-header border-primary">
        <div class="row">
            <div class="col-12">
                @if (Model.Vet!.Id == 0)
                {
                    <h3>Add a Vet</h3>
                }
                else
                {
                    <h3>Update Vet</h3>
                }
            </div>
        </div>
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Upsert" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row" hidden>
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet.Id"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet.Id" />
                    
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet.Doctor"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet.Doctor" />
                </div>
                <span asp-validation-for="@Model.Vet.Doctor" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet.Hospital"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet.Hospital" />
                </div>
                <span asp-validation-for="@Model.Vet.Hospital" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet!.Phone"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet!.Phone" />
                </div>
                <span asp-validation-for="@Model.Vet.Phone" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet!.Street1"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet!.Street1" />
                </div>
                <span asp-validation-for="@Model.Vet.Street1" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet!.Street2"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet!.Street2" />
                </div>
                <span asp-validation-for="@Model.Vet.Street2" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet!.City"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet!.City" />
                </div>
                <span asp-validation-for="@Model.Vet.City" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet!.State"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet!.State" />
                </div>
                <span asp-validation-for="@Model.Vet.State" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Vet!.ZipCode"></label>
                </div>
                <div class="col-6">
                    <input class="form-control" asp-for="@Model.Vet!.ZipCode" />
                </div>
                <span asp-validation-for="@Model.Vet.ZipCode" class="text-danger"></span>
            </div>
            <br />
            <div class="row">
                <div class="col-3 offset-4">
                    <button type="submit" value="Submit" class="btn btn-success form-control" style="width:180px;">Submit</button>
                </div>
                <div class="col-3 ">
                    <a class="btn btn-primary form-control" style="width:180px;" asp-action="Index">Back to List</a>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer border-primary" style="height:65px">
        <h6 class="text-success pt-2">Be good to your pets!</h6>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
