@model PetHealthcare.MVC.ViewModels.Auth.UserClaimsViewModel

@{
    ViewData["Title"] = $"User Claims";
}
<br />
<div class="card border-primary text-center text-light" style="height:80%;">
    <div class="card-header border-primary">
        <div class="row">
            <div class="col-12">
                <h3>User Claims</h3>
            </div>
        </div>
    </div>
    <div class="card-body text-info">
        <form enctype="multipart/form-data">
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Username"></label>
                </div>
                <div class="col-6">
                    <input inert class="form-control bg-light" asp-for="@Model.Username" />
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.Email"></label>
                </div>
                <div class="col-6">
                    <input inert class="form-control bg-light" asp-for="@Model.Email" />
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.CustomerNumber"></label>
                </div>
                <div class="col-6">
                    <input inert class="form-control bg-light" asp-for="@Model.CustomerNumber" />
                </div>
            </div>
            @foreach(var role in Model.Roles!)
            {
                <div class="row">
                    <div class="col-2 offset-2 ">
                        <label >Role</label>
                    </div>
                    <div class="col-6">
                        <input inert class="form-control bg-light" asp-for="@role" />
                    </div>
                </div>
            }
            @*<div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.JwtToken"></label>
                </div>
                <div class="col-6">
                    <textarea inert class="form-control bg-light" rows="9" asp-for="@Model.JwtToken"></textarea>
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.RefreshToken"></label>
                </div>
                <div class="col-6">
                    <textarea inert class="form-control bg-light" rows="2" asp-for="@Model.RefreshToken"></textarea>
                </div>
            </div>*@
            <br />
            @*<div class="row">
                <div class="col-3 offset-5">
                    <a class="btn btn-primary form-control" style="width:180px;" asp-action="Index">Home</a>
                </div>
            </div>*@
        </form>
    </div>
    <div class="card-footer border-primary" style="height:65px">
        <h6 class="text-success pt-2">Be good to your pets!</h6>
    </div>
</div>
