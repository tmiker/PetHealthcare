@model PetHealthcare.MVC.ViewModels.Auth.UpdatePasswordViewModel

@{
    ViewData["Title"] = "Update Password";
}
<br/>
<div class="card border-primary text-center text-light" style="height:80%;">
    <div class="card-header border-primary">
        <div class="row">
            <div class="col-12">
                <h3>Update Password</h3>
            </div>
        </div>
    </div>
    <br/>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.UpdatePasswordDTO!.Email"></label>
                </div>
                <div class="col-6">
                    <span >@Model.UpdatePasswordDTO!.Email</span>
                </div>
            </div>
            <br/>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.UpdatePasswordDTO!.OldPassword"></label>
                </div>
                <div class="col-6">
                    <input class="form-control bg-light" asp-for="@Model.UpdatePasswordDTO!.OldPassword" />
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.UpdatePasswordDTO!.NewPassword"></label>
                </div>
                <div class="col-6">
                    <input class="form-control bg-light" asp-for="@Model.UpdatePasswordDTO!.NewPassword" />
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.UpdatePasswordDTO!.ConfirmNewPassword"></label>
                </div>
                <div class="col-6">
                    <input class="form-control bg-light" asp-for="@Model.UpdatePasswordDTO!.ConfirmNewPassword" />
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-3 offset-4">
                    <button type="submit" value="Submit" class="btn btn-success form-control" style="width:180px;" asp-action="UpdatePassword">Update</button>
                </div>
                <div class="col-3">
                    <a class="btn btn-primary form-control" style="width:180px;" asp-action="Index">Cancel</a>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer border-primary" style="height:65px">
        <h6 class="text-success pt-2">Be good to your pets!</h6>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}