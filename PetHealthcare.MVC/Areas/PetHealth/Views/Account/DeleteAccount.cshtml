@model PetHealthcare.MVC.ViewModels.Account.DeleteAccountViewModel

@{
    ViewData["Title"] = "Delete Account";
}
<br />
<div class="card border-primary text-center text-danger" style="height:80%;">
    <div class="card-header border-primary">
        <div class="row">
            <div class="col-12">
                <h3>Delete Account</h3>
            </div>
        </div>
    </div>
    <br />
    <div class="card-body">
        <form method="post" asp-action="DeleteAccount" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.DeleteAccountDTO!.UserName"></label>
                </div>
                <div class="col-6">
                    <input inert class="form-control bg-light" asp-for="@Model.DeleteAccountDTO!.UserName" />
                </div>
            </div>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.DeleteAccountDTO!.Email"></label>
                </div>
                <div class="col-6">
                    <input inert class="form-control bg-light" asp-for="@Model.DeleteAccountDTO!.Email" />
                </div>
            </div>
            <br/>
            <div class="row">
                <div class="col-6 offset-4 ">
                    <hr class="text-danger"/>
                </div>
                
            </div>
            
            <div class="row">
                <div class="col-6 offset-4 ">
                    <h3 class="text-danger">Warning! All user data will be permanently deleted.</h3>
                    <h4 class="text-danger">Deleted data cannot be recovered.</h4>
                    <h4 class="text-danger">Please enter your password to confirm delete:</h4>
                </div>

            </div>
            <br/>
            <div class="row">
                <div class="col-2 offset-2 ">
                    <label asp-for="@Model.DeleteAccountDTO!.Password"></label>
                </div>
                <div class="col-6">
                    <input class="form-control bg-light" asp-for="@Model.DeleteAccountDTO!.Password" />
                </div>
            </div>

            <br />
            <div class="row">
                <div class="col-3 offset-4">
                    <button type="submit" value="Submit" class="btn btn-danger form-control" style="width:180px;" asp-action="DeleteAccount">Delete</button>
                </div>
                <div class="col-3">
                    <a class="btn btn-primary form-control" style="width:180px;" asp-action="Index">Cancel</a>
                </div>
            </div>
            <br/>
            <div class="row">
                <div class="col-6 offset-4 ">
                    <hr class="text-danger" />
                </div>

            </div>
        </form>
    </div>
    <div class="card-footer border-primary" style="height:65px">
        <h6 class="text-success pt-2">Be good to your pets!</h6>
    </div>
</div>
<!-- START DELETE CONFIRM MODAL -->
<!-- END DELETE CONFIRM MODAL -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
