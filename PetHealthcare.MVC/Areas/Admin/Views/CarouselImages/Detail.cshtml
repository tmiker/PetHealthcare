@model PetHealthcare.MVC.ViewModels.CarouselImages.CarouselImageDetailViewModel

@{
    ViewData["Title"] = $"Image Detail";
}
<br />
<div class="card border-primary text-center text-light">
    <div class="card-header border-warning">
        <div class="row">
            <div class="col-12">
                <h3>Details for @Model.CarouselImage!.Subject</h3>
            </div>
        </div>
    </div>
    <div class="card-body">
        <br/>
        <form enctype="multipart/form-data">
            <div hidden class="row">
                <div class="col-12 ">
                    <label asp-for="@Model.CarouselImage.Id"></label>
                </div>
                <div class="col-6">
                    <input inert class="form-control  bg-light" asp-for="@Model.CarouselImage.Id" />
                </div>
            </div>
            <div class="row">
                <div class="col-7">
                    <div class="row">
                        <div class="col-3 offset-1 ">
                            <label asp-for="@Model.CarouselImage.Subject"></label>
                        </div>
                        <div class="col-6">
                            <input inert class="form-control bg-light" asp-for="@Model.CarouselImage.Subject" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3 offset-1 ">
                            <label asp-for="@Model.CarouselImage.Caption"></label>
                        </div>
                        <div class="col-6">
                            <input inert class="form-control bg-light" asp-for="@Model.CarouselImage.Caption" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3 offset-1 ">
                            <label asp-for="@Model.CarouselImage.ImageURL"></label>
                        </div>
                        <div class="col-6">
                            <input inert class="form-control bg-light" asp-for="@Model.CarouselImage.ImageURL" />
                        </div>
                    </div>
                    
                    <br/>
                    <br />
                    <div class="row">
                        <div class="col-4 offset-5">
                            <a class="btn btn-outline-info form-control" style="width:180px;" asp-action="Index">Back to List</a>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <br/>
                    <div class="row">
                        <div class="col-12">
                            @if (Model.CarouselImage.ImageURL != null)
                            {
                                <img src="@Model.CarouselImage.ImageURL" width="380" />
                            }
                            else
                            {
                                <img src="~/dogicon4.png" width="380" />
                            }
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-12">
                            <h5 class="text-warning">@Model.CarouselImage.Subject</h5>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <h5 class="text-warning">@Model.CarouselImage.Caption</h5>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3 offset-1 ">
                            <label asp-for="@Model.CarouselImage.ImageFileName"></label>
                        </div>
                        <div class="col-8">
                            <input class="form-control" asp-for="@Model.CarouselImage.ImageFileName" />
                        </div>
                    </div>

                </div>
            </div>

            <br />

        </form>
    </div>
    <div class="card-footer border-warning">
        <h6 class="text-success">Be good to your pets!</h6>
    </div>
</div>
